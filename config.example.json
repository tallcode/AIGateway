{
  "port": 3000,
  "apiKey": "your-gateway-api-key",
  "verbose": false,
  "rectifiers": {
    "anthropicThinking": {
      "enabled": true
    }
  },
  "adapters": {
    "example-anthropic": {
      "protocol": "anthropic",
      "requestRules": [
        {
          "field": "thinking.budget_tokens",
          "action": "clamp",
          "value": [1, null]
        }
      ]
    }
  },
  "providers": {
    "openai": {
      "url": {
        "openai": "https://api.openai.com/v1",
        "anthropic": "https://api.anthropic.com/v1"
      },
      "apiKey": "sk-xxx",
      "cooldownSeconds": 60,
      "adapters": {
        "anthropic": "example-anthropic"
      }
    },
    "openai-backup": {
      "url": "https://openai-backup.example.com/v1",
      "apiKey": "sk-yyy",
      "responseApi": false
    }
  },
  "models": {
    "gpt-4": {
      "name": "GPT-4",
      "contextLength": 128000,
      "features": {
        "reasoning": true,
        "tools": true
      },
      "architecture": {
        "modality": "text+image"
      },
      "endpoints": [
        {
          "provider": "openai",
          "priority": 1
        },
        {
          "provider": "openai-backup",
          "modelName": "gpt-4-turbo",
          "cooldownSeconds": 120,
          "adapters": {
            "anthropic": "example-anthropic"
          },
          "priority": 2
        }
      ]
    }
  }
}
