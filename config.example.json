{
  "port": 3000,
  "apiKeys": {
    "laptop": "your-gateway-api-key",
    "phone": "your-gateway-api-key-2"
  },
  "verbose": false,
  "rectifiers": {
    "anthropicThinking": {
      "enabled": true
    }
  },
  "providers": {
    "openai": {
      "url": {
        "openai": "https://api.openai.com/v1",
        "response": "https://api.openai.com/v1",
        "anthropic": "https://api.anthropic.com/v1"
      },
      "apiKey": "sk-xxx",
      "cooldownSeconds": 60,
      "adapters": {
        "anthropic": "common-anthropic"
      }
    },
    "openai-backup": {
      "url": {
        "openai": "https://openai-backup.example.com/v1"
      },
      "apiKey": "sk-yyy"
    }
  },
  "models": {
    "gpt-4": {
      "name": "GPT-4",
      "contextLength": 128000,
      "features": {
        "reasoning": true,
        "tools": true
      },
      "architecture": {
        "modality": "text+image",
        "input_modalities": ["text", "image"],
        "output_modalities": ["text"]
      },
      "maxOutputTokens": 32000,
      "reasoning": {
        "mandatory": false,
        "default_enabled": true,
        "supported_efforts": ["high", "low"],
        "default_effort": "high"
      },
      "endpoints": [
        {
          "provider": "openai",
          "priority": 1
        },
        {
          "provider": "openai-backup",
          "modelName": "gpt-4-turbo",
          "cooldownSeconds": 120,
          "adapters": {
            "anthropic": "common-anthropic"
          },
          "priority": 2
        }
      ]
    }
  }
}
